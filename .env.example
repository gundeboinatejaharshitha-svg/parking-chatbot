# Local Ollama is the default; no OpenAI account or API key is needed.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
API_BASE_URL=http://127.0.0.1:8000

# Install Ollama, then run: ollama pull llama3.2:3b
# Optional OpenAI-compatible provider: set LLM_PROVIDER=openai, the matching
# LLM_MODEL and LLM_API_KEY, and LLM_BASE_URL (empty for api.openai.com).

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./chroma_db
SQLITE_URL=sqlite:///./parking.db
TOP_K=5
# Chunks scoring below this cosine similarity are ignored; if none remain the bot says it doesn't know
RAG_MIN_SCORE=0.3
LOG_LEVEL=INFO

# Stage 2: human-in-the-loop reservation approval (optional)
REQUIRE_ADMIN_APPROVAL=true
ADMIN_API_KEY=
ADMIN_NOTIFY_METHOD=console
# Only used when ADMIN_NOTIFY_METHOD=email:
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APPROVAL_REQUEST_TTL_HOURS=24
