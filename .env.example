# LLM provider: "openai" (any OpenAI-compatible API) or "ollama" (local, no key needed)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key
# Leave empty for api.openai.com. For Ollama the default is http://localhost:11434/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# Example local setup with Ollama:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./chroma_db
SQLITE_URL=sqlite:///./parking.db
TOP_K=5
# Chunks scoring below this cosine similarity are ignored; if none remain the bot says it doesn't know
RAG_MIN_SCORE=0.3
LOG_LEVEL=INFO
